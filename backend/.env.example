# Copy to .env to override defaults.
# Production example values shown below; for local dev use the prior defaults.

# --- Runtime ---
APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_USER_NAME=Naresh

# --- Database ---
# Local dev:    DATABASE_URL=sqlite:///./data/app.db
# Production:   DATABASE_URL=sqlite:////app/data/app.db  (Render/Railway persistent volume)
DATABASE_URL=sqlite:////app/data/app.db

# --- CORS ---
# Comma-separated list of allowed origins. Include your Vercel domain and
# any preview deployments. No trailing slashes.
CORS_ORIGINS=https://your-app.vercel.app,https://your-app-preview.vercel.app

# --- Seed ---
# Set to false in production if you import your own data; true on first
# boot to get a usable demo immediately. Idempotent: safe to leave on.
SEED_ON_START=true